# Enable legacy peer deps to avoid issues with native dependencies
legacy-peer-deps=true

# Increase network timeout for larger packages
network-timeout=100000

# Force exact versions for better stability
save-exact=true

# Don't omit optional dependencies as sharp and MathJax may need them
# omit=optional

# Enable verbose output for debugging
loglevel=verbose

# Configure sharp to work in serverless environments
sharp_binary_host=https://npmmirror.com/mirrors/sharp
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips

# Ensure MathJax v3 is installed with all required dependencies
fetch-retry-maxtimeout=60000
fetch-timeout=60000
