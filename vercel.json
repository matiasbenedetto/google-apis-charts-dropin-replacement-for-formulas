{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "nodeVersion": "20.x",
        "includeFiles": ["node_modules/sharp/**", "node_modules/mathjax/**", "node_modules/mathjax-node/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/chart(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
